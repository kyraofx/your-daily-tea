{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "newsroom:dry-run": "node scripts/newsroom/run.mjs --input scripts/newsroom/candidates.example.json",
    "newsroom:save": "node scripts/newsroom/run.mjs --input scripts/newsroom/candidates.example.json --save",
    "newsroom:retrieve": "node scripts/newsroom/retrieve.mjs",
    "newsroom:feeds": "node scripts/newsroom/collect-feeds.mjs",
    "newsroom:evaluate": "node scripts/newsroom/evaluate-feeds.mjs",
    "newsroom:audit-sources": "node scripts/newsroom/audit-sources.mjs",
    "newsroom:dedupe": "node scripts/newsroom/dedupe-candidates.mjs",
    "newsroom:generate-edition": "node scripts/newsroom/generate-edition.mjs",
    "newsroom:review-edition": "node scripts/newsroom/review-edition.mjs",
    "newsroom:save-reviewed": "node scripts/newsroom/save-reviewed-edition.mjs",
    "test:newsroom": "node --test tests/openai-newsroom.test.mjs tests/feeds.test.mjs tests/source-registry.test.mjs tests/dedupe.test.mjs tests/selection.test.mjs tests/full-edition.test.mjs tests/editorial-review.test.mjs tests/persistence.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "fast-xml-parser": "^5.11.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-loading-skeleton": "3.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
